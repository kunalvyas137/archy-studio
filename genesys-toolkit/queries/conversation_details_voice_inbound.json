{
  "interval": "{{interval}}",
  "order": "asc",
  "orderBy": "conversationStart",
  "paging": { "pageSize": 100, "pageNumber": 1 },
  "segmentFilters": [
    {
      "type": "and",
      "predicates": [
        { "dimension": "mediaType", "value": "voice" },
        { "dimension": "direction", "value": "inbound" }
      ]
    }
  ]
}
